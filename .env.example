# Chave da API da Anthropic (https://console.anthropic.com). Obrigatória para conversar com o agente.
ANTHROPIC_API_KEY=

# Modelo (padrão: claude-sonnet-5-5). Alternativa barata para testes: claude-haiku-5-5
EMPORIO_MODELO=claude-sonnet-5-5

# Esforço de raciocínio do modelo: low | medium | high (padrão: medium)
EMPORIO_ESFORCO=medium
